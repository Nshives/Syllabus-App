// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  courses   Course[]
}

model Course {
  id          Int          @id @default(autoincrement())
  title       String
  code        String?
  color       String       @default("#3b82f6") // <--- ADD THIS LINE!
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  assignments Assignment[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  dueDate   String?  // Format: YYYY-MM-DD
  status    String   @default("pending")
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
}

// A Major Project (e.g., "Final Senior Film")
model Project {
  id           Int           @id @default(autoincrement())
  title        String
  summary      String?       
  deliverables String?       
  turnInInfo   String?       
  dueDate      DateTime?
  userId       Int           // 👈 CHANGE THIS TO Int
  createdAt    DateTime      @default(now())
  steps        ProjectStep[] 
}

// The individual milestones for that project
model ProjectStep {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime?
  completed Boolean  @default(false)
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}